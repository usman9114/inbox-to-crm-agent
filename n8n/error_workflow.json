{
  "id": "inboxcrmerr1",
  "name": "Inbox to CRM: error handler",
  "nodes": [
    {
      "id": "et",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        100
      ],
      "parameters": {}
    },
    {
      "id": "sl",
      "name": "Slack: error alert",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [
        260,
        20
      ],
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "#automation-alerts"
        },
        "text": "=Workflow failed: {{ $json.workflow.name }}\nNode: {{ $json.execution.lastNodeExecuted }}\nError: {{ $json.execution.error.message }}\nExecution: {{ $json.execution.url }}",
        "otherOptions": {}
      }
    },
    {
      "id": "sheet:-errors",
      "name": "Sheet: Errors",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        260,
        200
      ],
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_SPREADSHEET_ID"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Errors"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "failed_at": "={{ $now.toISO() }}",
            "workflow": "={{ $json.workflow.name }}",
            "node": "={{ $json.execution.lastNodeExecuted }}",
            "error": "={{ $json.execution.error.message }}",
            "execution_id": "={{ $json.execution.id }}"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      }
    }
  ],
  "connections": {
    "Error Trigger": {
      "main": [
        [
          {
            "node": "Slack: error alert",
            "type": "main",
            "index": 0
          },
          {
            "node": "Sheet: Errors",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false,
  "versionId": "6f1d6a4e-0b57-4c0e-9d0a-5b0c7a222222",
  "pinData": {}
}
