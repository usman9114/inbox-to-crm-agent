# LLM provider: openrouter | openai | anthropic
LLM_PROVIDER=openrouter
# Optional model override (defaults: anthropic/claude-haiku-4.5 | gpt-4o-mini | claude-haiku-4-5)
LLM_MODEL=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# n8n -> mock/real sinks (used by scripts/send_samples.py)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/inbound-email
