# LLM provider: zai (default, Z.ai GLM free Flash models) | openrouter | openai | anthropic
LLM_PROVIDER=zai
# Optional model override (defaults: glm-4.5-flash | anthropic/claude-haiku-4.5 | gpt-4o-mini | claude-haiku-4-5)
LLM_MODEL=
ZAI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# n8n -> mock/real sinks (used by scripts/send_samples.py)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/inbound-email
